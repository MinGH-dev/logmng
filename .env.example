# =============================================================================
# LogMng 환경 변수 템플릿 (예시만 포함 — 실제 비밀은 넣지 마세요)
# =============================================================================
# 사용 절차:
#   cp .env.example .env
#   편집기로 값 채운 뒤 비대화형 설치 또는 런타임에 source / export
#
# 보안 (운영 필수):
#   - .env 는 저장소에 커밋하지 않습니다 (.gitignore에 .env 포함됨).
#   - chmod 600 .env  로 파일 권한을 소유자만 읽기/쓰기로 제한하세요.
#   - 비밀번호·PGPASSWORD·ENCRYPTION_KEY는 로그·캡처에 남기지 마세요.
#
# 비대화형 DB 부트스트랩 (저장소 루트):
#   INSTALL_NONINTERACTIVE=1 ./scripts/install_linux.sh
#   (또는 INSTALL_ENV_FILE 로 다른 경로의 env 파일 지정 가능)
#
# 변수 이름·의미의 권위: docs/contract.md (DB 설치 표, install_linux, LOGGING_FILE_NAME 등)
# =============================================================================

# -----------------------------------------------------------------------------
# install_linux.sh — 비대화형 래퍼 옵션
# -----------------------------------------------------------------------------
# INSTALL_NONINTERACTIVE — 보통 명령줄에서만 지정: 1 / true / yes 이면 메뉴 없이 setup.sh만 실행.
# INSTALL_ENV_FILE — 로드할 env 파일 경로. 미설정 시 저장소 루트의 .env
# INSTALL_WRITE_APP_ENV — 1이면 setup 성공 후 JDBC용 export 파일 생성
# INSTALL_APP_ENV_OUT — 생성 파일 경로. 기본 backend/.env.logmng.generated (.gitignore)
# INSTALL_NONINTERACTIVE=1
# INSTALL_ENV_FILE=
# INSTALL_WRITE_APP_ENV=0
# INSTALL_APP_ENV_OUT=

# -----------------------------------------------------------------------------
# SETUP_MODE — setup.sh / install_linux 비대화형 시 필수
# -----------------------------------------------------------------------------
# full      — Primary(A)·ImageLog(B)·split-PB 시 PB DB까지 전체 단계
# sys_only  — 시스템 쪽 DDL/마이그레이션 위주; PB 전용 DDL은 split 시 생략 → PB는 pb_only로 별도 실행
# pb_only   — PB 전용 DB만; DB_PB_NAME 필수. A/ImageLog 단계 없음
SETUP_MODE=full

# -----------------------------------------------------------------------------
# PostgreSQL 슈퍼유저 (DDL 실행에 쓰는 OS 역할/사용자 이름, psql -U 대상)
# -----------------------------------------------------------------------------
# 기본 postgres. Homebrew 등에서는 OS 사용자명이 슈퍼유저일 수 있음.
DB_SUPERUSER=postgres

# -----------------------------------------------------------------------------
# Primary / ImageLog 대상 클러스터 (같은 DB_HOST, DB_PORT)
# -----------------------------------------------------------------------------
# DB_HOST — PostgreSQL 호스트 (예: localhost, 내부 VIP)
DB_HOST=localhost
# DB_PORT — PostgreSQL 포트 (일반적으로 5432)
DB_PORT=5432
# DB_NAME — 레거시 DB 이름. DB_A_NAME을 안 쓸 때 시스템 DB(A) 이름으로 사용
DB_NAME=logmng
# DB_A_NAME — 시스템 스키마 및(비 split 시) PB DDL이 붙는 DB 이름. 비우면 DB_NAME과 동일 취급
# DB_A_NAME=
# DB_B_NAME — ImageLog DB. 비우거나 A와 같으면 단일 DB 구성
# DB_B_NAME=
# DB_USER — 애플리케이션 JDBC 역할(일반 권한)
DB_USER=logmng
# DB_PASSWORD — DB_USER 비밀번호. 예시 자리표시자만 두고 실제 값은 .env에만 기입
DB_PASSWORD=CHANGEME_APP_PASSWORD

# -----------------------------------------------------------------------------
# ETL 전용 역할 (ext_* 복제 등) — setup.sh 비대화형에서 full / sys_only 일 때 필수
# -----------------------------------------------------------------------------
# install_linux.sh는 이 둘을 사전 검사하지 않음. 누락 시 setup.sh가 변수 이름만 출력하고 종료.
DB_ETL_USER=logmng_etl
DB_ETL_PASSWORD=CHANGEME_ETL_PASSWORD

# -----------------------------------------------------------------------------
# 스키마 이름 — 반드시 런타임 APP_DB_SCHEMA_* 와 동일하게 맞출 것
# -----------------------------------------------------------------------------
SCHEMA_SYS=public
SCHEMA_PB=public
SCHEMA_IMAGELOG=public

# -----------------------------------------------------------------------------
# PB FEP 전용 PostgreSQL database (split-PB)
# -----------------------------------------------------------------------------
# DB_PB_NAME — 비우거나 DB_A_NAME과 같으면 PB DDL은 A DB에 적용(레거시)
# DB_PB_HOST / DB_PB_PORT — 기본은 DB_HOST / DB_PORT
# DB_PB_SUPERUSER — 기본은 DB_SUPERUSER
# pb_only 모드에서는 DB_PB_NAME 필수. 호스트/포트는 DB_PB_* 또는 DB_HOST/DB_PORT 조합으로 지정
# DB_PB_NAME=
# DB_PB_HOST=
# DB_PB_PORT=
# DB_PB_SUPERUSER=

# -----------------------------------------------------------------------------
# psql 클라이언트 → 슈퍼유저 인증 (trust/peer면 생략 가능)
# -----------------------------------------------------------------------------
# PGPASSWORD — 슈퍼유저용(또는 일반 규칙에 따른 클라이언트 비밀번호)
# PGPASSWORD_SUPER — 설정 시 스크립트가 내부에서 PGPASSWORD로 전달. 값은 절대 로그에 찍히지 않음
# PGPASSWORD=
# PGPASSWORD_SUPER=

# -----------------------------------------------------------------------------
# setup.sh — 초기 데이터·폐쇄망 옵션
# -----------------------------------------------------------------------------
# INIT_DATA_FILE — 기본 init-data.sql 경로는 setup.sh 기준
# SKIP_INIT_DATA — 1이면 init-data 실행 생략(DDL·마이그레이션은 유지)
# SYS_ONLY_LOAD_INIT_DATA — sys_only에서도 init-data를 돌리려면 1 (중복 주의)
# CLOSED_NETWORK_MINIMAL — 1이면 일부 샘플·선택 마이그레이션 생략
# INIT_DATA_FILE=
# SKIP_INIT_DATA=0
# SYS_ONLY_LOAD_INIT_DATA=0
# CLOSED_NETWORK_MINIMAL=0

# -----------------------------------------------------------------------------
# setup.sh 직접 호출 시 — 비대화형 검증 강제(선택)
# -----------------------------------------------------------------------------
# install_linux가 아닌 setup.sh만 실행할 때 1/true/yes 로 두면 필수 변수 검증 후 진행
# SETUP_NONINTERACTIVE=1

# =============================================================================
# Spring Boot 런타임 (배포 서버, systemd EnvironmentFile, 또는 수동 export)
# DB 프로비저닝 후 여기 값으로 기동. INSTALL_WRITE_APP_ENV=1 이면 일부가 생성 파일에 채워짐
# =============================================================================
# SERVER_PORT — HTTP 포트 (기본 9200)
# SERVER_PORT=9200

# LOGGING_FILE_NAME — Spring Boot relaxed binding → logging.file.name (파일 로그 경로)
# 미설정 시 기본 logs/application.log (저장소 application.yml과 동일)
# LOGGING_FILE_NAME=logs/application.log

# Primary JDBC
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/logmng
# SPRING_DATASOURCE_USERNAME=logmng
# SPRING_DATASOURCE_PASSWORD=CHANGEME_APP_PASSWORD

# 스키마(search_path 초기화) — setup.sh의 SCHEMA_* 와 동일 값 권장
# APP_DB_SCHEMA_SYS=public
# APP_DB_SCHEMA_PB=public
# APP_DB_SCHEMA_IMAGELOG=public

# PB FEP 전용 풀 — URL 비우면 Primary 풀 재사용(contract 참고)
# APP_DATASOURCE_PB_URL=
# APP_DATASOURCE_PB_USERNAME=
# APP_DATASOURCE_PB_PASSWORD=
# APP_DATASOURCE_PB_DRIVER=
# APP_DATASOURCE_PB_FAIL_FAST=
# APP_DATASOURCE_PB_INIT_FAIL_TIMEOUT_MS=

# ImageLog 전용 풀 — URL 비우면 Primary 풀 재사용
# APP_DATASOURCE_IMAGELOG_URL=
# APP_DATASOURCE_IMAGELOG_USERNAME=
# APP_DATASOURCE_IMAGELOG_PASSWORD=
# APP_DATASOURCE_IMAGELOG_DRIVER=
# APP_DATASOURCE_IMAGELOG_FAIL_FAST=
# APP_DATASOURCE_IMAGELOG_INIT_FAIL_TIMEOUT_MS=

# CORS — 브라우저 Origin 목록(쉼표). UI 주소와 정확히 일치해야 함
# CORS_ALLOWED_ORIGINS=http://localhost:3001

# 정적 UI 서버(JDK static-server) — 재빌드 없이 API 베이스 주입
# LOGMNG_API_BASE_URL=http://localhost:9200/api
# REACT_APP_API_BASE_URL=

# 암·복호화 (이미지 로그 등) — UTF-8 기준 32바이트 권장. 저장소에 실제 키 금지
# ENCRYPTION_KEY=CHANGEME_32BYTE_UTF8_SECRET_KEY!!
# 또는 APP_SECURITY_ENCRYPTION_KEY=
# DECRYPTION_ENABLED=true
# AUTO_DECRYPT_ON_KEYWORD_SEARCH=true
# FAILURE_HANDLING=fallback

# AD 로그인 등 (mode=ad 일 때 필수 항목은 contract·application.yml 참고)
# AUTH_AD_DOMAIN=
# auth.ad.ldap-url 대응 환경변수는 스프링 relaxed binding 규칙 따름

# bin/backend/run.sh — nohup 로그 디렉터리(선택). Spring 파일 로그는 LOGGING_FILE_NAME
# LOG_DIR=

# bin/frontend/run.sh
# PORT=3001
