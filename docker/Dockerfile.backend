# Runtime image: fat JAR from offline bundle only (no mvn package).
# Build from repository root after: ./scripts/build-offline-bundle.sh
#   docker compose -f docker/docker-compose.yml --project-directory . build backend
ARG DIST_VERSION=1.0.1
ARG BACKEND_JAR=logmng-backend-1.0.1.jar
FROM eclipse-temurin:17-jre-alpine
RUN apk add --no-cache curl
WORKDIR /app
COPY dist/logmng-offline-${DIST_VERSION}/bin/backend/${BACKEND_JAR} /app/logmng-backend.jar
EXPOSE 9200
ENV SERVER_PORT=9200
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
  CMD curl -sf http://127.0.0.1:${SERVER_PORT}/api/health >/dev/null || exit 1
ENTRYPOINT ["java","-jar","/app/logmng-backend.jar"]
