# Static UI + JDK static-server JAR from offline bundle only (no npm build in image).
# Args used in COPY must be declared *after* FROM.
FROM eclipse-temurin:17-jre
ARG DIST_VERSION=1.0.2
ARG STATIC_SERVER_JAR=logmng-static-server-1.0.0.jar
RUN apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY dist/logmng-offline-${DIST_VERSION}/bin/frontend/${STATIC_SERVER_JAR} /app/static-server.jar
COPY dist/logmng-offline-${DIST_VERSION}/bin/frontend/www /app/www
EXPOSE 3001
ENV PORT=3001
# Browser on host uses published port 3001 → API must be reachable from browser (localhost:9200).
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=5 \
  CMD curl -sf http://127.0.0.1:${PORT}/ >/dev/null || exit 1
ENTRYPOINT ["sh","-c","exec java -jar /app/static-server.jar /app/www ${PORT:-3001}"]
