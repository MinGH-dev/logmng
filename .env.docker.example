# Copy to `.env.docker` and replace secrets. Do not commit `.env.docker`.
# Compose variable substitution + backend env: use on every invocation:
#   docker compose --env-file .env.docker -f docker/docker-compose.yml --project-directory . …
# or: ./scripts/docker-local-manual-test.sh up
#
# Three PostgreSQL instances (three Compose services = three “hosts”): `postgres` (Primary / logmng),
# `postgres-pb` (PB FEP / pbfep), `postgres-imagelog` (ImageLog / imagelog). JDBC hosts must match
# those service names on the Docker network.

# --- Offline bundle path (must match ./scripts/build-offline-bundle.sh VERSION) ---
DIST_VERSION=1.0.2
OFFLINE_ROOT=./dist/logmng-offline-1.0.2
BACKEND_JAR=logmng-backend-1.0.2.jar
STATIC_SERVER_JAR=logmng-static-server-1.0.0.jar

# --- Postgres (compose services: postgres, postgres-pb, postgres-imagelog) ---
POSTGRES_PASSWORD=changeme
# Published host ports (container internal port is always 5432)
POSTGRES_PUBLISH_PORT=5433
POSTGRES_PB_PUBLISH_PORT=5434
POSTGRES_IMAGELOG_PUBLISH_PORT=5435

# --- Browser on host → API / UI (published ports) ---
LOGMNG_API_BASE_URL=http://localhost:9200/api
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# --- Spring Boot primary (system DB: logmng) — same credentials as db/setup.sh defaults unless you changed setup ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/logmng
SPRING_DATASOURCE_USERNAME=logmng
SPRING_DATASOURCE_PASSWORD=logmng123

# --- Dedicated PB FEP pool (database pbfep on postgres-pb) ---
APP_DATASOURCE_PB_URL=jdbc:postgresql://postgres-pb:5432/pbfep
APP_DATASOURCE_PB_USERNAME=logmng
APP_DATASOURCE_PB_PASSWORD=logmng123

# --- Dedicated ImageLog pool (database imagelog on postgres-imagelog) ---
APP_DATASOURCE_IMAGELOG_URL=jdbc:postgresql://postgres-imagelog:5432/imagelog
APP_DATASOURCE_IMAGELOG_USERNAME=logmng
APP_DATASOURCE_IMAGELOG_PASSWORD=logmng123

# --- App security (Docker bridge: browser appears as e.g. 172.x.x.x to the backend) ---
ENCRYPTION_KEY=12345678901234567890123456789012
APP_SECURITY_AUTHORIZED_IPS=127.0.0.1,localhost,0:0:0:0:0:0:0:1,::1,172.*,192.168.*,10.*

# --- Optional: db-init service (see docker-compose.yml) ---
# INIT_DATA_FILE=init-data-closed-network-admin-only.sql
# CLOSED_NETWORK_MINIMAL=1
# LOAD_LOCAL_DECRYPT_TEST_DATA=1
