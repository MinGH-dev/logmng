# Copy to `.env.docker` (not committed; add `.env.docker` to local git exclude if needed).
# Used by docker/docker-compose.yml for backend, db-init, and postgres alignment.
# For `docker compose` / `docker-compose` interpolation (host port, OFFLINE_ROOT, …), use repo-root `.env.docker`
# and either: `./scripts/docker-local-manual-test.sh` (loads it), or `docker-compose --env-file .env.docker …`, or `set -a && source .env.docker && set +a` before compose.
#
# Hostname `postgres` is the Docker service name (same Docker network). JDBC URLs must use `postgres`, not localhost,
# inside backend/frontend containers. Browser calls API at http://localhost:9200 — see LOGMNG_API_BASE_URL below.

# --- Offline bundle (build: ./scripts/build-offline-bundle.sh) ---
DIST_VERSION=1.0.1
OFFLINE_ROOT=./dist/logmng-offline-1.0.1
BACKEND_JAR=logmng-backend-1.0.1.jar
STATIC_SERVER_JAR=logmng-static-server-1.0.0.jar

# --- PostgreSQL (compose service `postgres`; superuser for setup.sh / db-init) ---
POSTGRES_PASSWORD=changeme
POSTGRES_PUBLISH_PORT=5433

# --- setup.sh (db-init) — must match three DB names and app role (non-interactive) ---
# Seed: default Docker compose uses init-data-closed-network-admin-only.sql (compatible with UNIQUE(user_id) on app_user_permission_group).
# For full dev sample users (user1, user2, …) you need a seed aligned with that constraint or adjust schema — see docker/README.md.
INIT_DATA_FILE=init-data-closed-network-admin-only.sql
CLOSED_NETWORK_MINIMAL=1
# Local/dev only: loads init-data-local-decrypt-test-*.sql after DDL (see backend/DB_SETUP_GUIDE.md). Not for production installs.
LOAD_LOCAL_DECRYPT_TEST_DATA=1
DB_HOST=postgres
DB_PORT=5432
DB_SUPERUSER=postgres
DB_A_NAME=logmng
DB_PB_NAME=pbfep
DB_B_NAME=imagelog
DB_USER=logmng
DB_PASSWORD=logmng123
DB_ETL_USER=logmng_etl
DB_ETL_PASSWORD=logmng_etl123
SCHEMA_SYS=public
SCHEMA_PB=public
SCHEMA_IMAGELOG=public
# PB split on same host as primary (typical compose):
DB_PB_HOST=postgres
DB_PB_PORT=5432
DB_PB_SUPERUSER=postgres

# --- Spring Boot: primary datasource (contract: spring.datasource.*) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/logmng
SPRING_DATASOURCE_USERNAME=logmng
SPRING_DATASOURCE_PASSWORD=logmng123

# --- Optional PB FEP + ImageLog pools (three physical DBs — set distinct URLs) ---
APP_DATASOURCE_PB_URL=jdbc:postgresql://postgres:5432/pbfep
APP_DATASOURCE_PB_USERNAME=logmng
APP_DATASOURCE_PB_PASSWORD=logmng123
APP_DATASOURCE_PB_DRIVER=
APP_DATASOURCE_PB_FAIL_FAST=true
APP_DATASOURCE_PB_INIT_FAIL_TIMEOUT_MS=30000

APP_DATASOURCE_IMAGELOG_URL=jdbc:postgresql://postgres:5432/imagelog
APP_DATASOURCE_IMAGELOG_USERNAME=logmng
APP_DATASOURCE_IMAGELOG_PASSWORD=logmng123
APP_DATASOURCE_IMAGELOG_DRIVER=
APP_DATASOURCE_IMAGELOG_FAIL_FAST=true
APP_DATASOURCE_IMAGELOG_INIT_FAIL_TIMEOUT_MS=30000

# --- Schema names (align with setup.sh SCHEMA_*) ---
APP_DB_SCHEMA_SYS=public
APP_DB_SCHEMA_PB=public
APP_DB_SCHEMA_IMAGELOG=public

# --- Server / CORS / security (application.yml + contract) ---
SERVER_PORT=9200
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:9200
# 로그인 시 IP 검사(AuthService). 호스트 브라우저→컨테이너 API는 127.0.0.1이 아니라 Docker 브리지(172.x 등)로 보일 수 있음 → 아래 없으면 "접근이 제한된 IP" 발생.
# 와일드카드는 IpUtil 규칙(예: 172.*). 운영에서는 범위를 좁히세요.
APP_SECURITY_AUTHORIZED_IPS=127.0.0.1,localhost,::1,0:0:0:0:0:0:0:1,172.*,192.168.*,10.*
ENCRYPTION_KEY=12345678901234567890123456789012
# Do not set APP_SECURITY_ENCRYPTION_KEY unless overriding; empty values break property resolution.
AUTH_LOGIN_MODE=local
AUTH_LOGIN_ALLOW_LOCAL_IN_PRODUCTION=false
AUTH_AD_LDAP_URL=
AUTH_AD_DOMAIN=
AUTH_AD_MANAGER_DN=
AUTH_AD_MANAGER_PASSWORD=
AUTH_AD_USER_SEARCH_BASE=
AUTH_AD_USER_SEARCH_FILTER=(sAMAccountName={0})
AUTH_AD_CONNECT_TIMEOUT_MS=5000
AUTH_AD_READ_TIMEOUT_MS=5000
AUTH_PROVISIONING_DEFAULT_SOURCE_SYSTEM=HR_SAMPLE

# --- Decryption / diagnostics ---
DECRYPTION_ENABLED=true
AUTO_DECRYPT_ON_KEYWORD_SEARCH=true
FAILURE_HANDLING=fallback
# Omit APP_DECRYPTION_* unless overriding — empty APP_DECRYPTION_ENABLED breaks boolean binding in Spring.
APP_DIAGNOSTIC_APPROVAL_FLOW=false
APP_DIAGNOSTIC_PERMISSION_GROUP_SCREEN=false
APP_DIAGNOSTIC_PROVISIONING_CONSISTENCY=false

# --- Logging ---
LOGGING_FILE_NAME=

# --- HR Sync PoC (optional) ---
HR_SYNC_POC_ENABLED=false
HR_SYNC_POC_APPLY_ENABLED=false
HR_SYNC_POC_DEFAULT_MODE=PREVIEW_ONLY

# --- Frontend static server (host browser → backend on published port) ---
LOGMNG_API_BASE_URL=http://localhost:9200/api
