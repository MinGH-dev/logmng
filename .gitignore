# Dependencies & build (tracked elsewhere or regenerable)
node_modules/
frontend/build/

# Backend (backend/.gitignore also has target/, .idea/, etc.)
backend/target/

# Maven output under tools/ (e.g. airgap static server)
tools/**/target/

# macOS AppleDouble (do not commit)
._*

# Air-gap / deploy bundle (bin/ is deploy-only; dev uses backend/target + npm start)
bin/backend/*.jar
bin/frontend/*.jar
# Static UI output under www/ (large); keep empty tree in Git via .gitkeep only
bin/frontend/www/**
!bin/frontend/www/.gitkeep

# Offline bundle output (from scripts/build-offline-bundle.sh)
dist/

# PostgreSQL client .debs for bundle (scripts/download-psql-for-bundle.sh)
third_party/psql-deb/
# PostgreSQL client RPMs for RHEL 9.6 bundle (scripts/download-psql-rpm-el9.sh)
third_party/psql-rpm-el9/

# Logs
logs/
*.log

# Env with secrets (do not commit)
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# .cursor, docs, specs are NOT listed here — they remain addable.
